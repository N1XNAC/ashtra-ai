# Ashtra AI — copy to .env and fill in
# Free open-source cloud model (Groq free dev tier, no credit card):
# 1. Sign up at https://console.groq.com
# 2. Create an API key, paste below, restart backend.
GROQ_API_KEY=gsk-...
# Optional: pick another free open-weight model served by Groq
# (e.g. openai/gpt-oss-20b, openai/gpt-oss-120b, llama-3.3-70b-versatile, qwen/qwen3-32b)
GROQ_MODEL=openai/gpt-oss-20b

# --- Vision link (describe-then-chat): vision model reads an attached image,
# writes text context for the text brain. Recommended: OpenRouter free tier
# (free key, no card, 50 req/day). The openrouter/free router auto-selects a
# free vision-capable model, so no model ID can go stale:
#   VISION_BASE_URL=https://openrouter.ai/api/v1
#   VISION_API_KEY=sk-or-...
#   VISION_MODEL=openrouter/free
# Backup: NVIDIA NIM free tier (40 req/min, key at build.nvidia.com):
#   VISION_BASE_URL=https://integrate.api.nvidia.com/v1
#   VISION_API_KEY=nvapi-...
#   VISION_MODEL=meta/llama-3.2-11b-vision-instruct
# (HuggingFace is pay-as-you-go now with tiny free credits — not recommended.)
# VISION_BASE_URL=
# VISION_API_KEY=
# VISION_MODEL=
# --- Safety (optional; localhost defaults are already tight) ---
# Bind to 127.0.0.1 only. Require shared secret on every API route
# (browser must send it as X-API-Key header, see frontend VITE_API_KEY).
# API_KEY=change-me-to-something-long-and-random
# Abuse caps (per minute). DOCS_ENABLED=0 hides /docs + /openapi.json.
# RATE_LIMIT_PER_MINUTE=60
# CHAT_RATE_LIMIT_PER_MINUTE=20
# MAX_MESSAGE_LENGTH=4000
# DOCS_ENABLED=1

# Optional: any other OpenAI-compatible endpoint (takes priority over Groq)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
